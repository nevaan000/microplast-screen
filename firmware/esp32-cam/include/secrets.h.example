#pragma once

// Copy this file to secrets.h and fill in your own values. secrets.h is git-ignored.
// The DEVICE_API_KEY here must match DEVICE_API_KEY in the backend .env exactly.

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

// Advertised over mDNS as <DEVICE_NAME>.local, so the dashboard can reach the
// camera at http://microplast-cam.local/ instead of a DHCP-assigned address.
#define DEVICE_NAME "microplast-cam"

// LAN address of the computer running the MicroPlast Screen backend, including
// its port and no trailing slash.
#define SERVER_URL "http://192.168.1.100:8000"
#define DEVICE_API_KEY "replace-with-the-device-api-key"

// Optional hardware overrides. Both pins are only free when no microSD card is
// fitted, because the card slot uses GPIO 12-15. Set EXTERNAL_LED_PIN to -1 to
// drive only the on-board flash LED.
//
// GPIO 12 (MTDI) is a strapping pin: driving it high at reset selects 1.8 V
// flash and the board will not boot. The firmware therefore uses it for the
// button with an internal pull-down, idling low. Wire the button between
// GPIO 12 and 3V3, never to a pull-up.
// #define EXTERNAL_LED_PIN 13
// #define CAPTURE_BUTTON_PIN 12
// #define CAPTURE_BUTTON_FRAMES 3
