# Required. Every record lives in Postgres. Use the pooled (-pooler) connection
# string from Neon, or a local server:
#   docker run -d --name mps-postgres -e POSTGRES_USER=microplast \
#     -e POSTGRES_PASSWORD=microplast_dev_only -e POSTGRES_DB=microplast \
#     -p 5433:5432 postgres:17-alpine
DATABASE_URL=

# Images, masks and the trained classifier go to a Vercel Blob store when these
# are set, and to DATA_DIR otherwise. A store is private or public for life and
# cannot be switched later; this app serves every asset through a login, so
# create a private one.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Force a backend regardless of the two values above: "blob" or "local".
ASSET_BACKEND=

# Scratch space for the local asset backend. Must be writable.
DATA_DIR=data

DEVICE_API_KEY=change-this-local-device-key
ESP32_IP=
# A request body above 4.5 MB is rejected at Vercel's edge before the app sees
# it, so the default sits under that. Raise it only on a self-hosted server.
MAX_UPLOAD_MB=4
# Analyses beyond this count queue instead of running at once; one function
# instance fits a single maximum-size analysis.
MAX_CONCURRENT_ANALYSES=1
HOST=127.0.0.1
PORT=8000
# Leave ADMIN_PASSWORD empty for local/LAN use without a login.
# Set it (and optionally ADMIN_USER) before exposing the server to the internet.
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_HOURS=12
